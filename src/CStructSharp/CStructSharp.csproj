<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>CStructSharp</PackageId>
    <Authors>Vincent Vollers</Authors>
    <Description>Parse, inspect, serialize, and update binary streams and mapped memory using C-style structures and metadata layouts.</Description>
    <PackageTags>binary;parser;cstruct;struct;serialization;memory;btf;isf</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/vvollers/CStructSharp</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Release notes: https://github.com/vvollers/CStructSharp/blob/main/CHANGELOG.md. Documentation: https://vvollers.github.io/cstructsharp/docs/. Report issues at https://github.com/vvollers/CStructSharp/issues.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/vvollers/CStructSharp.git</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <VersionPrefix>0.12.1</VersionPrefix>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <!-- Trim-safe on both targets. The Native AOT claim is made for net10.0, where Array.CreateInstanceFromArrayType
         exists and the AOT analyzer understands RuntimeFeature.IsDynamicCodeSupported guards. -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net10.0'">true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- The compile-time core (parser, expressions, compiled model, placement, diagnostics, introspection) is a
         shared source folder: it compiles into this assembly and into the source generator (netstandard2.0). -->
    <Compile Include="..\CStructSharp.Core\**\*.cs" LinkBase="Core" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The [CStructLayout]/[CStructMapped] source generator and the analyzer ship inside this package: the consumer's
         compiler loads them from analyzers/dotnet/cs, and build/CStructSharp.props/.targets wire .cstruct files and the
         DisableCStructSharpGenerator switch. The generator has no assembly of its own on NuGet. -->
    <ProjectReference Include="..\CStructSharp.Generators\CStructSharp.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\CStructSharp.Generators\bin\$(Configuration)\netstandard2.0\CStructSharp.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="build\CStructSharp.props" Pack="true" PackagePath="build" />
    <None Include="build\CStructSharp.targets" Pack="true" PackagePath="build" />
  </ItemGroup>

  <!--
    Public documentation only. The compiler's XML file documents every member, internal and private ones included,
    because every declaration here carries a documentation comment; about three quarters of it described internals that
    IntelliSense never shows. After compilation the build tool writes a copy with only the externally visible types and
    their public or protected members, and that copy replaces the compiler's file in bin/ and in the package.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\tools\build\PublicDocumentation\PublicDocumentation.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <PublicDocumentationTool>$(MSBuildThisFileDirectory)..\..\tools\build\PublicDocumentation\bin\$(Configuration)\net8.0\PublicDocumentation.dll</PublicDocumentationTool>
    <!-- The dotnet CLI sets DOTNET_HOST_PATH; Visual Studio's MSBuild may not, so fall back to the dotnet on PATH. -->
    <PublicDocumentationHost>$(DOTNET_HOST_PATH)</PublicDocumentationHost>
    <PublicDocumentationHost Condition="'$(PublicDocumentationHost)' == ''">dotnet</PublicDocumentationHost>
  </PropertyGroup>

  <!-- The intermediate path and target name are only known once the SDK targets are evaluated, so the output path is
       set in a target rather than in the project body. -->
  <Target Name="PreparePublicDocumentationPath">
    <PropertyGroup>
      <PublicDocumentationFile>$(IntermediateOutputPath)public-documentation\$(TargetName).xml</PublicDocumentationFile>
    </PropertyGroup>
  </Target>

  <!-- Incremental: reruns only when the assembly or the compiler's XML file changed. -->
  <Target Name="FilterPublicDocumentation" AfterTargets="CoreCompile" DependsOnTargets="PreparePublicDocumentationPath" Condition="'@(DocFileItem)' != ''"
          Inputs="@(IntermediateAssembly);@(DocFileItem);$(PublicDocumentationTool)" Outputs="$(PublicDocumentationFile)">
    <Exec Command="&quot;$(PublicDocumentationHost)&quot; &quot;$(PublicDocumentationTool)&quot; &quot;@(IntermediateAssembly->'%(FullPath)')&quot; &quot;@(DocFileItem->'%(FullPath)')&quot; &quot;$(PublicDocumentationFile)&quot;" StandardOutputImportance="low" />
  </Target>

  <!-- Separate from the filter so the swap also happens when the filter was up to date and skipped. The copy to bin/
       and the package's documentation entry both read DocFileItem after this point. -->
  <Target Name="UsePublicDocumentation" AfterTargets="FilterPublicDocumentation" Condition="'@(DocFileItem)' != ''">
    <ItemGroup>
      <!-- Both files are build outputs; listing them keeps IncrementalClean from deleting them. -->
      <FileWrites Include="@(DocFileItem);$(PublicDocumentationFile)" />
      <DocFileItem Remove="@(DocFileItem)" />
      <DocFileItem Include="$(PublicDocumentationFile)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Local copies may intentionally have no Git remote. Release/CI checkouts do, so enable Source Link there and
         avoid emitting misleading local-build warnings while still validating every publishable symbol package. -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" Condition="'$(CI)' == 'true'">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
