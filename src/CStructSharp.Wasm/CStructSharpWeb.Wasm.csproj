<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    
    <!-- WASM-specific settings -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <WasmBuildNative>true</WasmBuildNative>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WasmDebugLevel Condition="'$(Configuration)' == 'Release'">0</WasmDebugLevel>
    <WasmEmitSourceMap Condition="'$(Configuration)' == 'Release'">false</WasmEmitSourceMap>
    <WasmEmitSymbolMap Condition="'$(Configuration)' == 'Release'">false</WasmEmitSymbolMap>
    
    <!-- The browser bridge uses source-generated JSON metadata and explicit value projection. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <!--
      Suppresses IL2026/IL2075/IL2067/IL2072/IL2111 warnings from CStruct.TryGetMemberValue's and
      TypedValueConverter's unannotated reflection (the POCO fallback used by Serialize/UpdateStream when a value
      is not dictionary-shaped). Statically reachable, never executed from the browser: CStructJsonConversion
      always produces dictionary/list shapes. See docs/project/web-development.md ("Managed bridge trimming").
    -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    
    <!-- Nothing is loaded dynamically; the full trim needs the static closure only. -->
    <EnableDynamicLoading>false</EnableDynamicLoading>
    
    <!-- Browser JavaScript entry point -->
    <WasmMainJSPath>main.js</WasmMainJSPath>
    
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CStructSharp\CStructSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      No C# runtime-binder call site executes in the browser build (parsed values are StructValue, the bridge
      handles them as object), so Microsoft.CSharp is no longer rooted and the trimmer drops it (E3.10).
    -->
    <!--
      Member-trim the library and the bridge for this publish only (the library's NuGet metadata does not claim
      IsTrimmable). Measured (E3.10): the publication shrank from 5.35 MB / 2.05 MB gzip to 4.36 MB / 1.66 MB gzip.
    -->
    <TrimmableAssembly Include="CStructSharp" />
    <TrimmableAssembly Include="CStructSharpWeb.Wasm" />
  </ItemGroup>

</Project>
