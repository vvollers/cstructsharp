<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    
    <!-- WASM-specific settings -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <WasmBuildNative>true</WasmBuildNative>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WasmDebugLevel Condition="'$(Configuration)' == 'Release'">0</WasmDebugLevel>
    <WasmEmitSourceMap Condition="'$(Configuration)' == 'Release'">false</WasmEmitSourceMap>
    <WasmEmitSymbolMap Condition="'$(Configuration)' == 'Release'">false</WasmEmitSymbolMap>
    
    <!-- The browser bridge uses source-generated JSON metadata and explicit value projection. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    
    <!-- Nothing is loaded dynamically; the full trim needs the static closure only. -->
    <EnableDynamicLoading>false</EnableDynamicLoading>
    
    <!-- Browser JavaScript entry point -->
    <WasmMainJSPath>../../packages/cstructsharp/src/main.js</WasmMainJSPath>
    
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CStructSharp\CStructSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Marks the bridge assembly itself as trimmable, so the WebAssembly publish removes its unused members as well.
      The library already declares itself trimmable (IsTrimmable in its own project), so this setting is needed
      only for this publish. No C# runtime-binder call site runs in the browser build (parsed values are
      StructValue and the bridge handles them as object), so nothing roots Microsoft.CSharp and the trimmer
      removes it. Together this keeps the downloaded runtime small.
    -->
    <TrimmableAssembly Include="CStructSharpWeb.Wasm" />
  </ItemGroup>

</Project>
