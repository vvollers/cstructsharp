<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    
    <!-- WASM-specific settings -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <WasmBuildNative>true</WasmBuildNative>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WasmDebugLevel Condition="'$(Configuration)' == 'Release'">0</WasmDebugLevel>
    <WasmEmitSourceMap Condition="'$(Configuration)' == 'Release'">false</WasmEmitSourceMap>
    <WasmEmitSymbolMap Condition="'$(Configuration)' == 'Release'">false</WasmEmitSymbolMap>
    
    <!-- The browser bridge uses source-generated JSON metadata and explicit value projection. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!--
      Suppresses IL2026/IL2075/IL2067/IL2072/IL2111 warnings from two genuinely reachable sources: every
      dynamic/ExpandoObject result path (needs Microsoft.CSharp's runtime binder) and CStruct.TryGetMemberValue's
      and TypedValueConverter's unannotated reflection (the POCO-property fallback used by Serialize/UpdateStream
      when a value is not already dictionary/ExpandoObject-shaped). The second group is statically reachable but
      never actually hit from the browser: CStructJsonConversion always produces the dynamic/dictionary shape, so
      that reflection branch never executes here. See docs/project/web-development.md for the measured
      investigation (removing the CStructSharp trim root below changes nothing - see that root's own comment) and
      for the resulting consequence that WriteOptions.BindingMode has no observable effect through the JS API.
    -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    
    <!-- Preserve reflection for dynamic binding -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    
    <!-- Browser JavaScript entry point -->
    <WasmMainJSPath>main.js</WasmMainJSPath>
    
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CStructSharp\CStructSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Browser values use ExpandoObject and the runtime binder; keep that reflection surface intact. -->
    <TrimmerRootAssembly Include="Microsoft.CSharp" />
    <!--
      Measured to have no effect on published bundle size (byte-identical CStructSharp.wasm output with or
      without this root): under TrimMode=partial, an application assembly that has not opted in to trimming
      (IsTrimmable) is never member-trimmed regardless of rooting. Kept for clarity of intent and because it
      costs nothing to keep; do not expect removing it to shrink the bundle.
    -->
    <TrimmerRootAssembly Include="CStructSharp" />
  </ItemGroup>

</Project>
