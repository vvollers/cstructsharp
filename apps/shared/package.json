{
  "name": "@cstructsharp/app-shared",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "Source shared by the explorer and the inspector: components and modules both applications compile from source.",
  "exports": {
    "./*.vue": "./src/*.vue",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run --dir src --environment happy-dom --passWithNoTests"
  },
  "peerDependencies": {
    "monaco-editor": "^0.56.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "eslint-plugin-jsdoc": "^64.5.4"
  }
}
