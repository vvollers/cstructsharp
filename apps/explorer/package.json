{
  "name": "cstructsharp-explorer",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "generate:demos": "node scripts/generate-test-demos.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test:demos": "node --test scripts/generate-test-demos.test.mjs",
    "test:unit": "vitest run --dir src --environment happy-dom",
    "test:generated-csharp": "node scripts/test-generated-csharp.mjs",
    "test:e2e": "playwright test",
    "dev": "npm run generate:demos && vite",
    "build": "node scripts/build-production.mjs",
    "build:frontend": "npm run generate:demos && vue-tsc -b && vite build",
    "preview": "vite preview",
    "build:wasm": "node ../../tools/packaging/publish-wasm.mjs",
    "copy:wasm": "node scripts/copy-wasm.mjs",
    "refresh:catalog": "node scripts/refresh-catalog-baseline.mjs"
  },
  "dependencies": {
    "monaco-editor": "^0.56.0",
    "vue": "^3.5.42",
    "vuehex": "^0.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "2.5.1",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "dompurify": "^3.4.15"
  }
}
