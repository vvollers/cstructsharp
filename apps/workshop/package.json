{
  "name": "cstruct-sharp-web",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "generate:demos": "node scripts/generate-test-demos.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test:bootstrap": "node --test ../../src/CStructSharp.Wasm/bootstrap.test.js ../../src/CStructSharp.Wasm/cstructsharp-wasm.test.js",
    "test:demos": "node --test scripts/generate-test-demos.test.mjs",
    "test:wasm-publication": "node --test ../../tools/packaging/wasm-publication.test.mjs",
    "test:wasm-reproducibility": "node ../../tools/packaging/test-wasm-reproducibility.mjs",
    "test:unit": "vitest run --dir src --environment happy-dom",
    "test:generated-csharp": "node scripts/test-generated-csharp.mjs",
    "verify:wasm": "node ../../tools/packaging/verify-wasm-publication.mjs",
    "pack:npm": "node ../../tools/packaging/create-wasm-npm-package.mjs",
    "test:npm": "node ../../tools/packaging/test-npm-package.mjs",
    "test:npm:node": "node ../../tools/packaging/test-npm-package.mjs --node-only",
    "test:npm-release": "node --test ../../tools/release/npm-release.test.mjs ../../tools/release/release-state.test.mjs",
    "test:e2e": "playwright test",
    "dev": "npm run generate:demos && vite",
    "build": "node scripts/build-production.mjs",
    "build:frontend": "npm run generate:demos && vue-tsc -b && vite build",
    "preview": "vite preview",
    "build:wasm": "node ../../tools/packaging/publish-wasm.mjs",
    "copy:wasm": "node scripts/copy-wasm.mjs"
  },
  "dependencies": {
    "monaco-editor": "^0.56.0",
    "vue": "^3.5.42",
    "vuehex": "^0.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "2.5.0",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.12.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "dompurify": "^3.4.15"
  }
}
