{
  "name": "cstructsharp-inspector",
  "version": "0.12.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run --dir src --environment happy-dom",
    "test:e2e": "playwright test",
    "dev": "vite",
    "build": "node ../shared/scripts/build-production.mjs",
    "build:frontend": "vue-tsc -b && vite build",
    "copy:wasm": "node ../shared/scripts/copy-wasm.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@cstructsharp/app-shared": "*",
    "@iconify-icons/vscode-icons": "^2.0.8",
    "@iconify/vue": "^5.0.3",
    "@vueuse/core": "^15.0.0",
    "dockview-vue": "^8.3.1",
    "file-type": "22.1.1",
    "json-editor-vue": "^0.19.2",
    "monaco-editor": "^0.57.0",
    "vanilla-jsoneditor": "^3.13.0",
    "vue": "^3.5.43",
    "vuehex": "^0.7.0"
  }
}
