{
  "name": "cstruct-sharp-inspector",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run --dir src --environment happy-dom",
    "test:e2e": "playwright test",
    "dev": "vite",
    "build": "node scripts/build-production.mjs",
    "build:frontend": "vue-tsc -b && vite build",
    "copy:wasm": "node scripts/copy-wasm.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@iconify-icons/vscode-icons": "^2.0.4",
    "@iconify/vue": "^5.0.1",
    "@vueuse/core": "^15.0.0",
    "dockview-vue": "^8.3.1",
    "file-type": "22.1.0",
    "json-editor-vue": "^0.19.2",
    "monaco-editor": "^0.56.0",
    "vanilla-jsoneditor": "^3.13.0",
    "vue": "^3.5.42",
    "vuehex": "^0.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.6.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "2.5.1",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "dompurify": "^3.4.15"
  }
}
