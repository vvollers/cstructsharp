<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup Condition="'$(StarterVariant)' != 'next'">
    <Compile Remove="Next.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(StarterVariant)' == 'next'">
    <Compile Remove="Program.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(CStructSharpPackageVersion)' == ''">
    <ProjectReference Include="../../../CStructSharp/CStructSharp.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(CStructSharpPackageVersion)' != ''">
    <PackageReference Include="CStructSharp" Version="$(CStructSharpPackageVersion)" />
  </ItemGroup>
</Project>
