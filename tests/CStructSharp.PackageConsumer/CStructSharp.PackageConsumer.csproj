<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CStructSharpPackageVersion Condition="'$(CStructSharpPackageVersion)' == ''">0.0.0-package-version-required</CStructSharpPackageVersion>
    <!-- CS7022: the linked memory example keeps its own Main for its documentation project; Program.cs calls it. -->
    <NoWarn>$(NoWarn);CS7022</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The runner supplies the version read from the package under test. This must never become a ProjectReference. -->
    <PackageReference Include="CStructSharp" Version="$(CStructSharpPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The memory-analysis guide examples, compiled against the installed package instead of the core project. -->
    <Compile Include="../../docs/examples/memory-analysis/Program.cs" Link="MemoryAnalysis/Program.cs" />
    <Compile Include="../../docs/examples/memory-analysis/MemoryTutorialExamples.cs" Link="MemoryAnalysis/MemoryTutorialExamples.cs" />
  </ItemGroup>

</Project>
