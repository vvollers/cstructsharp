<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>CStructSharp.Generators.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="MSTest" Version="4.4.1" />
    <!-- The same Roslyn the generator is built against, so the driver exercises the API surface consumers load. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <!-- The generator compiles the Core sources, so it defines the same public option and exception types as the runtime; the alias keeps the test code unambiguous. -->
    <ProjectReference Include="..\..\src\CStructSharp.Generators\CStructSharp.Generators.csproj" Aliases="Generators" />
    <ProjectReference Include="..\..\src\CStructSharp\CStructSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\contracts\language\manual-fixtures-v1.json" Link="manual-fixtures-v1.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The golden files live beside the tests; UPDATE_SNAPSHOTS=1 rewrites them in place. They are text the tests
         compare, not sources of this project: each one is compiled by the test that produced it. -->
    <Compile Remove="Snapshots/**" />
    <AssemblyMetadata Include="SnapshotDirectory" Value="$(MSBuildProjectDirectory)/Snapshots" />
  </ItemGroup>

</Project>
