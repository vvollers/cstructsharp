<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="local-memory-packages" value="%CSTRUCTSHARP_MEMORY_PACKAGE_SOURCE%" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local-memory-packages">
      <package pattern="CStructSharp" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
