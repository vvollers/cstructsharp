{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/src/Stryker.CLI/Stryker.CLI/Resources/stryker.schema.json",
  "stryker-config": {
    "project": "src/CStructSharp/CStructSharp.csproj",
    "test-projects": [
      "tests/CStructSharpTests/CStructSharpTests.csproj"
    ],
    "coverage-analysis": "off",
    "test-case-filter": "FullyQualifiedName!=CStructSharp.Tests.PublicApiSurfaceTests.ExportedTypesAndSignatures_AreDeliberateAndImplementationAgnostic",
    "mutate": [
      "CStruct.cs",
      "CStructAddressResolver.cs",
      "CStructCompilationOptions.cs",
      "CStructCompiledModel.cs",
      "Parsing/LayoutParser.cs",
      "Codecs/EnumFieldValueParser.cs",
      "Codecs/EnumIntegerCodec.cs",
      "Codecs/EnumIntegerCodecTable.cs",
      "Diagnostics/ExceptionContext.cs",
      "Codecs/BitfieldCodecTable.cs",
      "CStructLayout.cs",
      "Compilation/LayoutMath.cs",
      "Reading/CStructOperationContext.cs",
      "Writing/CStructElementWriterState.cs",
      "Reading/ReadOperationSettings.cs",
      "Addressing/CStructPathResolver.cs",
      "Addressing/CStructPointerArithmetic.cs",
      "CStructPrimitiveCodecs.cs",
      "CStructReader.cs",
      "CStructSelectedReader.cs",
      "Compilation/SymbolValidation.cs",
      "CStructValueReader.cs",
      "CStructWriter.cs",
      "Compilation/ConstructionDictionary.cs",
      "Values/EnumValueResult.cs",
      "Expressions/ExpressionEvaluationLimits.cs",
      "Expressions/ExpressionEvaluator.cs",
      "Expressions/LayoutVariableInput.cs",
      "Expressions/LayoutVariableResolver.cs",
      "Values/Pointer.cs",
      "Streams/ReadBudgetStream.cs",
      "Streams/SparseUpdateStream.cs",
      "Values/TypedValueConverter.cs",
      "Syntax/Enum.cs",
      "Syntax/Field.cs",
      "Syntax/Literal.cs",
      "Values/UnionValue.cs",
      "Streams/WriteBudgetStream.cs",
      "Compilation/CompiledCompositeType.cs",
      "Compilation/CompiledField.cs",
      "Compilation/CompiledSizeQueries.cs",
      "Reading/ConditionalFieldSelection.cs",
      "Reading/ConditionalVariableScope.cs",
      "CStructConditionalFields.cs",
      "Diagnostics/DebugPath.cs",
      "Codecs/FixedPointCodec.cs"
    ],
    "reporters": [
      "progress",
      "json",
      "html"
    ],
    "thresholds": {
      "high": 75,
      "low": 75,
      "break": 75
    }
  }
}
