<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CStructSharp\CStructSharp.csproj" />
    <!-- GeneratedBenchmarks: the fixture layouts as [CStructLayout] classes, generated at build time. -->
    <ProjectReference Include="..\..\src\CStructSharp.Generators\CStructSharp.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- Fixture loading (benchmarks/fixtures) is shared with the fixture tool so both read identical inputs. -->
    <ProjectReference Include="..\CStructSharp.FixtureTool\CStructSharp.FixtureTool.csproj" />
  </ItemGroup>

  <!--
    PacketBenchmarks: the comparison project's data-dependent packet (layout, mapped class, sample and accessors),
    compiled here from the same source files so both projects measure the same layout and bytes.
  -->
  <ItemGroup>
    <Compile Include="..\CStructSharp.Comparison\Fingerprint.cs" Link="Packet\Fingerprint.cs" />
    <Compile Include="..\CStructSharp.Comparison\Variable\PacketAccessors.cs" Link="Packet\PacketAccessors.cs" />
    <Compile Include="..\CStructSharp.Comparison\Variable\PacketDto.cs" Link="Packet\PacketDto.cs" />
    <Compile Include="..\CStructSharp.Comparison\Variable\PacketLayout.cs" Link="Packet\PacketLayout.cs" />
    <Compile Include="..\CStructSharp.Comparison\Variable\PacketSample.cs" Link="Packet\PacketSample.cs" />
  </ItemGroup>

</Project>
