<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot Condition="'$(MemoryPublishAot)' == 'true'">true</PublishAot>
    <DefineConstants Condition="'$(MemoryReferenceAssembly)' != ''">$(DefineConstants);MEMORY_REFERENCE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/CStructSharp/CStructSharp.csproj" Condition="'$(MemoryReferenceAssembly)' == ''" />
    <Reference Include="CStructSharp" HintPath="$(MemoryReferenceAssembly)" Condition="'$(MemoryReferenceAssembly)' != ''" />
  </ItemGroup>
</Project>
