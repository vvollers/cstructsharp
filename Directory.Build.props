<Project>

  <!--
    Shared MSBuild defaults for every project in the repository. A project may override any property below by
    setting it again in its own .csproj; MSBuild evaluates later assignments after this file's, so a project-level
    value always wins.
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Compiler and analyzer warnings fail the build in every project; CI cannot pass a new warning silently. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Every declaration is documented (AGENTS.md). Generating the XML file turns on the compiler's and StyleCop's
         documentation rules; only SA1623 and SA1642, which prescribe summary wording rather than presence, are off. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);SA1623;SA1642</NoWarn>
  </PropertyGroup>

  <!-- Every project is held to the same analyzer gate by default. -->
  <ItemGroup>
    <PackageReference Include="Roslynator.Analyzers" Version="5.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
